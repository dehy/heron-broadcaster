# Copy to .env and edit before `docker compose up`.

# Image tag of the Heron services: latest (the last release), edge (main),
# or a release such as 0.1.0. `docker compose up --build` builds from source.
HERON_VERSION=latest

# MariaDB passwords. Use URL-safe characters (letters, digits, - and _):
# the API password is embedded in a database URL.
HERON_DB_PASSWORD=change-me
HERON_DB_ROOT_PASSWORD=change-me-too

# Host directories mounted into the containers.
HERON_MUSIC_DIR=./data/music
HERON_FALLBACK_DIR=./data/fallback
# Drop files here: they move into the buffer zone, where heron-librarian
# identifies them, and are filed into the music directory once imported
# from the web interface.
HERON_INCOMING_FOLDER=./data/incoming
# The buffer zone: uploads and incoming files waiting to be imported.
HERON_STAGING_FOLDER=./data/staging

# User and group heron-librarian and heron-api run as: the owner of
# HERON_MUSIC_DIR, HERON_INCOMING_FOLDER and HERON_STAGING_FOLDER, as given
# by `id -u` and `id -g`.
HERON_LIBRARIAN_USER=1000:1000

# Seconds between full library scans. File changes also trigger a scan,
# unless watching is off (set HERON_LIBRARY_WATCH=false for network shares
# that do not report changes).
HERON_SCAN_INTERVAL=3600
HERON_LIBRARY_WATCH=true

# Host port of the web interface.
HERON_HTTP_PORT=8000

# Host port of the optional local Icecast server (docker compose --profile icecast).
HERON_ICECAST_PORT=8010

# Log level for the Rust services (tracing EnvFilter syntax).
RUST_LOG=info

# Error reporting to Sentry (https://sentry.io or self-hosted), off when
# empty. The services' DSN stays on the server; the web app's DSN is read by
# browsers, so give it a project of its own. See docs/monitoring.md#sentry.
HERON_SENTRY_DSN=
HERON_WEB_SENTRY_DSN=
HERON_SENTRY_ENVIRONMENT=production

# Monitoring (docker compose --profile monitoring): Grafana's port and the
# password of its `admin` user, and how long Prometheus keeps metrics.
HERON_GRAFANA_PORT=3000
HERON_GRAFANA_ADMIN_PASSWORD=change-me-as-well
HERON_METRICS_RETENTION=30d
